{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": false,
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "single_quote": true,
        "trailing_comma_in_multiline": {
            "elements": ["arrays", "arguments", "parameters"]
        },
        "phpdoc_align": {
            "align": "left"
        },
        "concat_space": {
            "spacing": "one"
        },
        "not_operator_with_successor_space": false
    },
    "exclude": [
        "bootstrap/cache",
        "storage"
    ]
}
