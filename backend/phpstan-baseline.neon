parameters:
	ignoreErrors:
		-
			message: '#^Method App\\Http\\Controllers\\Api\\V1\\BaseApiController\:\:error\(\) has parameter \$errors with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Http/Controllers/Api/V1/BaseApiController.php

		-
			message: '#^Method App\\Http\\Controllers\\Api\\V1\\BaseApiController\:\:paginated\(\) has parameter \$paginator with generic interface Illuminate\\Contracts\\Pagination\\LengthAwarePaginator but does not specify its types\: TKey, TValue$#'
			identifier: missingType.generics
			count: 1
			path: app/Http/Controllers/Api/V1/BaseApiController.php

		-
			message: '#^Using nullsafe property access "\?\-\>id" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Providers/AppServiceProvider.php

		-
			message: '#^Using nullsafe property access "\?\-\>tenant_id" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Providers/AppServiceProvider.php

		-
			message: '#^Called ''env'' outside of the config directory which returns null when the config is cached, use ''config''\.$#'
			identifier: larastan.noEnvCallsOutsideOfConfig
			count: 1
			path: app/Providers/HorizonServiceProvider.php

		-
			message: '#^Called ''env'' outside of the config directory which returns null when the config is cached, use ''config''\.$#'
			identifier: larastan.noEnvCallsOutsideOfConfig
			count: 1
			path: app/Providers/TelescopeServiceProvider.php

		-
			message: '#^Method App\\Support\\ApiExceptionRenderer\:\:modelNotFoundMessage\(\) has parameter \$e with generic class Illuminate\\Database\\Eloquent\\ModelNotFoundException but does not specify its types\: TModel$#'
			identifier: missingType.generics
			count: 1
			path: app/Support/ApiExceptionRenderer.php

		-
			message: '#^Method App\\Support\\ApiResponse\:\:error\(\) has parameter \$errors with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Support/ApiResponse.php

		-
			message: '#^Method App\\Support\\ApiResponse\:\:paginated\(\) has parameter \$paginator with generic interface Illuminate\\Contracts\\Pagination\\LengthAwarePaginator but does not specify its types\: TKey, TValue$#'
			identifier: missingType.generics
			count: 1
			path: app/Support/ApiResponse.php

		-
			message: '#^Method App\\Support\\ApiResponse\:\:success\(\) has parameter \$headers with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Support/ApiResponse.php
