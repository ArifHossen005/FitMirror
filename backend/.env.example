APP_NAME=FitMirror
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# APP_TIMEZONE stays UTC (see PROGRESS.md decision D-07) — this is the zone used
# for tenant-local display conversion at the presentation layer only, never storage.
TENANT_DEFAULT_TIMEZONE=Asia/Dhaka

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Frontend application URLs (used in emails, CORS, redirects) ---
FRONTEND_URL=http://localhost:5173
KIOSK_URL=http://localhost:5174
PORTAL_URL=http://localhost:5175
MISSION_URL=http://localhost:5176
TENANT_ROOT_DOMAIN=fitmirror.test

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: MySQL 8.4 on port 3307 (NOT XAMPP MariaDB on 3306) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=fitmirror
DB_USERNAME=fitmirror
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Redis (Memurai 7.2.5 on Windows) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# --- Cache / Session / Queue all on Redis, each its own logical DB (see config/database.php) ---
CACHE_STORE=redis
CACHE_PREFIX=fitmirror_cache
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue

BROADCAST_CONNECTION=reverb

# --- Horizon ---
HORIZON_PREFIX=fitmirror_horizon:

# --- Search ---
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# --- Filesystem (local for dev, s3 for production) ---
FILESYSTEM_DISK=local
# TENANT_DISK_DRIVER overrides the "tenant" disk driver directly if needed.
# Left blank, it follows FILESYSTEM_DISK: "local" locally, "s3" in production.
TENANT_DISK_DRIVER=

# --- Mail: Mailtrap sandbox SMTP for local/staging, Amazon SES in production ---
# Local:      MAIL_MAILER=smtp, host=sandbox.smtp.mailtrap.io, port=2525, fill in your Mailtrap inbox credentials
# Production: MAIL_MAILER=ses, plus AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION below (SES uses the same AWS credentials as S3)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@fitmirror.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage (AWS S3 / Cloudflare R2) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Reverb (WebSockets) â€” credentials generated by `php artisan reverb:install`, see bottom of file ---

# --- Monitoring ---
SENTRY_LARAVEL_DSN=
# Environment tag sent to Sentry — left blank so it falls back to APP_ENV automatically
SENTRY_ENVIRONMENT=
# Release tag — set in CI to the deployed commit SHA, e.g. SENTRY_RELEASE=$(git rev-parse HEAD)
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.0
# TELESCOPE_ENABLED is only honoured in local/staging — AppServiceProvider never
# registers Telescope in production regardless of this value (see D-06 rules).
TELESCOPE_ENABLED=true

# --- Payments: SSLCommerz ---
SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
SSLC_SANDBOX=true
SSLC_SUCCESS_URL=${APP_URL}/api/v1/payment/callback/success
SSLC_FAIL_URL=${APP_URL}/api/v1/payment/callback/fail
SSLC_CANCEL_URL=${APP_URL}/api/v1/payment/callback/cancel
SSLC_IPN_URL=${APP_URL}/api/v1/payment/ipn
# Left blank deliberately — see config/sslcommerz.php's own docblock for why
# these two aren't defaulted to a guessed URL the way the four above are.
SSLC_REFUND_INITIATE_ENDPOINT=
SSLC_REFUND_QUERY_ENDPOINT=

# --- Tax ---
VAT_RATE=0.15

# --- SMS gateway (Bangladesh) ---
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER_ID=FitMirror

# --- Background removal service (AR-ready product images) ---
BG_REMOVAL_ENDPOINT=
BG_REMOVAL_KEY=

# --- Mission Control super admin seed ---
SUPER_ADMIN_NAME="Product Owner"
SUPER_ADMIN_EMAIL=owner@fitmirror.com
SUPER_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"


REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
